{
  "name": "@adjskit/core",
  "version": "0.1.0",
  "description": "Runtime framework for adjskit discord.js bots.",
  "keywords": [
    "discord",
    "discord-js",
    "discord.js",
    "bot",
    "framework",
    "commands",
    "slash-commands",
    "components",
    "modals",
    "cooldowns",
    "typescript"
  ],
  "homepage": "https://github.com/devs-des1re/adjskit#readme",
  "bugs": {
    "url": "https://github.com/devs-des1re/adjskit/issues"
  },
  "license": "MIT",
  "author": "Arjun Patel (devs-des1re)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devs-des1re/adjskit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepack": "node ../../scripts/sync-package-assets.mjs",
    "postpack": "node ../../scripts/sync-package-assets.mjs --clean"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
